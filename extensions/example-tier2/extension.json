      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "if (!gdjs.__exampleTier2) {",
            "  gdjs.__exampleTier2 = {",
            "    // Map<cooldownName, msTimestampWhenItEnds>",
            "    until: new Map(),",
